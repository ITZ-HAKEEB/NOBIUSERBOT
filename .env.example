# Telegram API Credentials (obtain from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Owner's Telegram User ID (numeric, e.g. from @userinfobot)
OWNER_ID=123456789

# Optional Default String Session for a Dedicated Global Selfbot Tagger (Pyrogram v2)
# If provided, this Self ID can be used by authorized users or as fallback
DEFAULT_STRING_SESSION=

# Tagger Settings
TAG_DELAY=2.5
USERS_PER_TAG=1

# Database Settings
DATABASE_PATH=tagger_bot.db
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=multitasking
DB_NAME=multitasking
